generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
}

datasource db {
  provider = "postgresql"
}

enum AlcoholType {
  MALT_BEVERAGE
  WINE
  DISTILLED_SPIRITS
}

enum ApplicationStatus {
  PENDING
  PROCESSING
  READY
  PROCESSED
  REJECTED
}

enum LabelType {
  FRONT
  BACK
}

model Application {
  id           String            @id @default(uuid())
  ttb_id       String            @unique
  brand_name   String
  alcohol_type AlcoholType
  status       ApplicationStatus @default(PENDING)
  rejection_reason String?       // Store reason if rejected
  user_id      String?           // For concurrency lock
  locked_at    DateTime?
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt

  images       LabelImage[]
  verification VerificationResult?
}

model LabelImage {
  id             String      @id @default(uuid())
  application_id String
  s3_key         String
  type           LabelType
  created_at     DateTime    @default(now())

  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
}

model VerificationResult {
  id             String      @id @default(uuid())
  application_id String      @unique
  checklist_json Json?       // Stores structured output from Claude
  raw_ocr_json   Json?       // Stores Rekognition output
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
}